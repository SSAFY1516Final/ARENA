# Required: GMS key used by Spring AI through the OpenAI-compatible proxy.
GMS_KEY=your-gms-key
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com
GMS_COMPLETIONS_PATH=/v1/chat/completions
GMS_MODEL=gpt-5.4-mini

# Required: at least 32 characters. Used to sign JWT access tokens.
JWT_SECRET=change-this-to-a-long-random-secret-key-32chars

# Optional
JWT_EXPIRATION_SECONDS=86400
MYSQL_ROOT_PASSWORD=arena-root-password
MYSQL_PORT=3306
APP_PORT=8080
CLIENT_PORT=15173
VITE_API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:15173,http://127.0.0.1:15173

# Kakao OAuth login. Use the Kakao Developers REST API key.
KAKAO_REST_API_KEY=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:15173/auth/kakao/callback
VITE_KAKAO_REST_API_KEY=your-kakao-rest-api-key
VITE_KAKAO_REDIRECT_URI=http://localhost:15173/auth/kakao/callback
