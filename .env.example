# Required: OpenAI API key used by Spring AI.
OPENAI_API_KEY=sk-your-openai-api-key

# Required: at least 32 characters. Used to sign JWT access tokens.
JWT_SECRET=change-this-to-a-long-random-secret-key-32chars

# Optional
JWT_EXPIRATION_SECONDS=86400
OPENAI_MODEL=gpt-4o-mini
MYSQL_ROOT_PASSWORD=arena-root-password
MYSQL_PORT=3306
APP_PORT=8080

# Kakao OAuth login. Use the Kakao Developers REST API key.
KAKAO_REST_API_KEY=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback
